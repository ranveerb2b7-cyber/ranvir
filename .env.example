# SellerScope environment variables. Copy to .env and fill in. NEVER commit real values.
# Values here are local-development placeholders only.

# ---- General ----
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated browser origins; add chrome-extension://<id> in M12
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Schema owner: used ONLY by migrations (alembic upgrade head).
POSTGRES_USER=sellerscope
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sellerscope
MIGRATION_DATABASE_URL=postgresql+asyncpg://sellerscope:change-me-local-only@localhost:5432/sellerscope
# Restricted app role: used by the API and workers. Subject to row-level security, no DDL.
APP_DB_ROLE=sellerscope_app
APP_DB_PASSWORD=change-me-app-local-only
DATABASE_URL=postgresql+asyncpg://sellerscope_app:change-me-app-local-only@localhost:5432/sellerscope

# ---- Redis (Celery broker/results, rate limits, locks) ----
REDIS_URL=redis://localhost:6379/0

# ---- Mock connector: dev/test ONLY. Startup fails if true in staging/production. ----
ENABLE_MOCK_CONNECTOR=false
# How often MOCK listings change (seconds), so change tracking can be seen in development
MOCK_EPOCH_SECONDS=600

# ---- File storage (uploaded product files) ----
# local = disk (development/tests only). Staging/production refuse to start unless s3.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.storage
# S3-compatible storage (AWS S3 in ap-south-1, Cloudflare R2, or MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=sellerscope-local
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=change-me-local-only
S3_SECRET_ACCESS_KEY=change-me-local-only

# ---- Product uploads ----
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_ROWS=50000

# ---- Authentication (Supabase Auth) ----
# Local: the GoTrue container in docker-compose signs HS256 tokens with AUTH_JWT_SECRET.
# Hosted Supabase: set AUTH_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1 and
# AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json (no secret needed).
AUTH_JWT_ISSUER=http://localhost:54321/auth/v1
# At least 32 random characters. Generate: openssl rand -hex 32
AUTH_JWT_SECRET=change-me-local-only-at-least-32-characters
# AUTH_JWKS_URL=
# Password of the local GoTrue database role (docker-compose only)
AUTH_DB_PASSWORD=change-me-auth-local-only

# ---- Email (API invitations). Local: Mailpit at http://localhost:8025 ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=SellerScope <no-reply@sellerscope.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# Alert emails: attempts before giving up, and the first retry delay (doubles each time, max 1h)
ALERT_DELIVERY_MAX_ATTEMPTS=5
ALERT_DELIVERY_BACKOFF_S=60
# Base URL of the web app, used in emailed links
WEB_BASE_URL=http://localhost:3000

# ---- Web (only NEXT_PUBLIC_* reaches the browser; never put secrets there) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Local gateway in front of GoTrue; hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Public (anon/publishable) key. Not a secret. Local GoTrue ignores it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-dev-anon-key

# ---- Added in later milestones (placeholders, not used yet) ----
# M7: SPAPI_LWA_CLIENT_ID=  SPAPI_LWA_CLIENT_SECRET=  SPAPI_APP_ID=
# M7: SPAPI_REGION_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# M7: CREDENTIAL_ENCRYPTION_KEY= (dev only; production uses KMS_KEY_ID=)
